# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/homidirect

# JWT Configuration
# Generate a strong random secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
NODE_ENV=development
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIMEWINDOW=15m

# Future: OAuth Configuration (uncomment when implementing)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# FACEBOOK_APP_ID=your-facebook-app-id
# FACEBOOK_APP_SECRET=your-facebook-app-secret
# FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# Future: Email Configuration (uncomment when implementing)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM=noreply@homidirect.com

# Alternative SMTP Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
