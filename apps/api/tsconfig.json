{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "db/*": ["./src/db*"],
      "types/*": ["./src/types/*"],
      "config/*": ["./src/config/*"],
      "utils/*": ["./src/utils/*"],
      "modules/*": ["./src/modules/*"],
      "models/*": ["./src/models/*"],
      "plugins/*": ["./src/plugins/*"],
      "schemas/*": ["./src/schemas/*"],
      "middleware/*": ["./src/middleware/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/types/**/*.d.ts", "drizzle.config.ts"]
}
