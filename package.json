{
  "name": "homidirect",
  "version": "1.0.0",
  "private": true,
  "description": "Homidirect monorepo - Real estate platform",
  "scripts": {
    "dev:web": "pnpm --filter @homidirect/web dev",
    "dev:api": "cd apps/api && uv run uvicorn src.main:app --host 0.0.0.0 --port 5000 --reload",
    "build": "turbo run build",
    "build:web": "pnpm --filter @homidirect/web build",
    "build:api": "cd apps/api && uv sync",
    "type-check": "turbo run type-check",
    "preview:web": "pnpm --filter @homidirect/web preview",
    "preview:api": "cd apps/api && uv run uvicorn src.main:app --host 0.0.0.0 --port 5000",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "lint:api": "cd apps/api && uv run ruff check src/",
    "test": "turbo run test",
    "test:api": "cd apps/api && uv run pytest",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "cd apps/api && uv run alembic upgrade head",
    "db:generate": "cd apps/api && uv run alembic revision --autogenerate -m"
  },
  "devDependencies": {
    "turbo": "^2.6.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
